generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(dbgenerated("('user_'::text || nextval('\"User_id_seq\"'::regclass))"))
  name      String
  email     String   @unique
  password  String
  token     String
  createdAt DateTime @default(now())
  domains   Domain[]
}

model Domain {
  id               String            @id @default(dbgenerated("('domain_'::text || nextval('\"Domain_id_seq\"'::regclass))"))
  userId           String
  name             String
  url              String
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subdomains       Subdomain[]
  dnsRecords       DnsRecord[]
  securityHeaders  SecurityHeader[]
  exposedResources ExposedResource[]

  @@unique([userId, name])
  @@index([userId])
}


model DnsRecord {
  id        String   @id @default(dbgenerated("('dns_record_'::text || nextval('\"DnsRecord_id_seq\"'::regclass))"))
  domainId  String
  type      String
  name      String
  value     String
  ttl       Int?
  createdAt DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([domainId, type])
}

model Subdomain {
  id              String                @id @default(dbgenerated("('subdomain_'::text || nextval('\"Subdomain_id_seq\"'::regclass))"))
  domainId        String
  hostname        String
  ipAddress       String?
  status          String                @default("ACTIVE")
  firstSeenAt     DateTime              @default(now())
  lastSeenAt      DateTime              @default(now())
  createdAt       DateTime              @default(now())
  domain          Domain                @relation(fields: [domainId], references: [id], onDelete: Cascade)
  ports           Port[]
  sslCertificates SslCertificate[]
  technologies    SubdomainTechnology[]

  @@unique([domainId, hostname])
  @@index([domainId])
}

model Port {
  id          String    @id @default(dbgenerated("('port_'::text || nextval('\"Port_id_seq\"'::regclass))"))
  subdomainId String
  port        Int
  protocol    String    @default("tcp")
  service     String?
  state       String    @default("open")
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  subdomain   Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@unique([subdomainId, port, protocol])
  @@index([subdomainId])
}

model SslCertificate {
  id              String    @id @default(dbgenerated("('ssl_certificate_'::text || nextval('\"SslCertificate_id_seq\"'::regclass))"))
  subdomainId     String
  issuer          String?
  subject         String?
  validFrom       DateTime?
  expiresAt       DateTime?
  tlsVersion      String?
  fingerprint     String?
  valid           Boolean?
  validationError String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subdomain Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@unique([subdomainId])
  @@index([subdomainId])
}

model Technology {
  id         String                @id @default(dbgenerated("('technology_'::text || nextval('\"Technology_id_seq\"'::regclass))"))
  name       String                @unique
  category   String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  subdomains SubdomainTechnology[]
}

model SubdomainTechnology {
  id           String     @id @default(dbgenerated("('subdomain_technology_'::text || nextval('\"SubdomainTechnology_id_seq\"'::regclass))"))
  subdomainId  String
  technologyId String
  version      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subdomain    Subdomain  @relation(fields: [subdomainId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([subdomainId, technologyId])
  @@index([subdomainId])
  @@index([technologyId])
}


model SecurityHeader {
  id         String   @id @default(dbgenerated("('security_header_'::text || nextval('\"SecurityHeader_id_seq\"'::regclass))"))
  domainId   String
  url        String
  headerName String
  present    Boolean
  value      String?
  severity   String?
  scannedAt  DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, scannedAt])
}

model ExposedResource {
  id          String   @id @default(dbgenerated("('exposed_resource_'::text || nextval('\"ExposedResource_id_seq\"'::regclass))"))
  domainId    String
  url         String
  path        String
  statusCode  Int?
  accessible  Boolean
  severity    String?
  scannedAt   DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, scannedAt])
}
