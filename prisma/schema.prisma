generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(dbgenerated("('user_'::text || nextval('\"User_id_seq\"'::regclass))"))
  name      String
  email     String    @unique
  password  String
  token     String
  createdAt DateTime  @default(now())
  domains   Domain[]
  networks  Network[]
}

model Domain {
  id        String   @id @default(dbgenerated("('domain_'::text || nextval('\"Domain_id_seq\"'::regclass))"))
  userId    String
  name      String
  url       String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subdomains       Subdomain[]
  dnsRecords       DnsRecord[]
  securityHeaders  SecurityHeader[]
  exposedResources ExposedResource[]
  alerts           Alert[]
  scans            Scan[]
  changes          Change[]

  @@unique([userId, name])
  @@index([userId])
}

model DnsRecord {
  id        String   @id @default(dbgenerated("('dns_record_'::text || nextval('\"DnsRecord_id_seq\"'::regclass))"))
  domainId  String
  type      String
  name      String
  value     String
  ttl       Int?
  createdAt DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([domainId, type])
}

model Subdomain {
  id              String                @id @default(dbgenerated("('subdomain_'::text || nextval('\"Subdomain_id_seq\"'::regclass))"))
  domainId        String
  hostname        String
  ipAddress       String?
  status          String                @default("ACTIVE")
  firstSeenAt     DateTime              @default(now())
  lastSeenAt      DateTime              @default(now())
  createdAt       DateTime              @default(now())
  domain          Domain                @relation(fields: [domainId], references: [id], onDelete: Cascade)
  ports           Port[]
  sslCertificates SslCertificate[]
  technologies    SubdomainTechnology[]

  @@unique([domainId, hostname])
  @@index([domainId])
}

model Port {
  id          String    @id @default(dbgenerated("('port_'::text || nextval('\"Port_id_seq\"'::regclass))"))
  subdomainId String
  port        Int
  protocol    String    @default("tcp")
  service     String?
  state       String    @default("open")
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  subdomain   Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@unique([subdomainId, port, protocol])
  @@index([subdomainId])
}

model SslCertificate {
  id              String    @id @default(dbgenerated("('ssl_certificate_'::text || nextval('\"SslCertificate_id_seq\"'::regclass))"))
  subdomainId     String
  issuer          String?
  subject         String?
  validFrom       DateTime?
  expiresAt       DateTime?
  tlsVersion      String?
  fingerprint     String?
  valid           Boolean?
  validationError String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subdomain Subdomain @relation(fields: [subdomainId], references: [id], onDelete: Cascade)

  @@unique([subdomainId])
  @@index([subdomainId])
}

model Technology {
  id         String                @id @default(dbgenerated("('technology_'::text || nextval('\"Technology_id_seq\"'::regclass))"))
  name       String                @unique
  category   String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  subdomains SubdomainTechnology[]
}

model SubdomainTechnology {
  id           String     @id @default(dbgenerated("('subdomain_technology_'::text || nextval('\"SubdomainTechnology_id_seq\"'::regclass))"))
  subdomainId  String
  technologyId String
  version      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subdomain    Subdomain  @relation(fields: [subdomainId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([subdomainId, technologyId])
  @@index([subdomainId])
  @@index([technologyId])
}

model SecurityHeader {
  id         String   @id @default(dbgenerated("('security_header_'::text || nextval('\"SecurityHeader_id_seq\"'::regclass))"))
  domainId   String
  url        String
  headerName String
  present    Boolean
  value      String?
  severity   String?
  scannedAt  DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, scannedAt])
}

model ExposedResource {
  id         String   @id @default(dbgenerated("('exposed_resource_'::text || nextval('\"ExposedResource_id_seq\"'::regclass))"))
  domainId   String
  url        String
  path       String
  statusCode Int?
  accessible Boolean
  severity   String?
  scannedAt  DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, scannedAt])
}

// Belongs to exactly one of domain / network (check constraint in the migration).
model Alert {
  id        String   @id @default(dbgenerated("('alert_'::text || nextval('\"Alert_id_seq\"'::regclass))"))
  domainId  String?
  networkId String?
  type      String
  severity  String
  title     String
  message   String
  metadata  Json?
  key       String?
  createdAt DateTime @default(now())

  domain  Domain?  @relation(fields: [domainId], references: [id], onDelete: Cascade)
  network Network? @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([domainId, key])
  @@unique([networkId, key])
  @@index([domainId, createdAt])
  @@index([networkId, createdAt])
  @@index([severity])
}

model Scan {
  id          String    @id @default(dbgenerated("('scan_'::text || nextval('\"Scan_id_seq\"'::regclass))"))
  domainId    String
  status      String    @default("QUEUED")
  trigger     String    @default("manual")
  steps       Json?
  snapshot    Json?
  changeCount Int       @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  domain  Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  changes Change[]

  @@index([domainId, createdAt])
  @@index([status])
}

model Change {
  id        String   @id @default(dbgenerated("('change_'::text || nextval('\"Change_id_seq\"'::regclass))"))
  domainId  String
  scanId    String
  category  String
  type      String
  key       String
  severity  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([domainId, createdAt])
  @@index([scanId])
}

// ---------------------------------------------------------------------------
// Local network scanning. The phone scans and uploads results; the server never
// connects to these addresses. See network-apis.md.
// ---------------------------------------------------------------------------

model Network {
  id             String   @id @default(dbgenerated("('network_'::text || nextval('\"Network_id_seq\"'::regclass))"))
  userId         String
  name           String
  subnet         String
  identifierHash String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans   NetworkScan[]
  devices NetworkDevice[]
  changes NetworkChange[]
  alerts  Alert[]

  @@unique([userId, name])
  @@index([userId])
}

model NetworkScan {
  id           String    @id @default(dbgenerated("('network_scan_'::text || nextval('\"NetworkScan_id_seq\"'::regclass))"))
  networkId    String
  status       String    @default("RUNNING")
  progress     Json?
  summary      Json?
  changeCount  Int       @default(0)
  error        String?
  lastUploadAt DateTime?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  network      Network                    @relation(fields: [networkId], references: [id], onDelete: Cascade)
  observations NetworkDeviceObservation[]
  changes      NetworkChange[]

  @@index([networkId, createdAt])
  @@index([status])
}

// identityKey is `mac:<mac>` when the MAC is known, otherwise `ip:<ip>`.
model NetworkDevice {
  id          String   @id @default(dbgenerated("('network_device_'::text || nextval('\"NetworkDevice_id_seq\"'::regclass))"))
  networkId   String
  identityKey String
  identity    String
  macAddress  String?
  vendor      String?
  firstSeenAt DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  network      Network                    @relation(fields: [networkId], references: [id], onDelete: Cascade)
  observations NetworkDeviceObservation[]
  changes      NetworkChange[]

  @@unique([networkId, identityKey])
  @@index([networkId, lastSeenAt])
}

model NetworkDeviceObservation {
  id              String   @id @default(dbgenerated("('network_observation_'::text || nextval('\"NetworkDeviceObservation_id_seq\"'::regclass))"))
  scanId          String
  deviceId        String
  ipAddress       String
  hostname        String?
  macAddress      String?
  discoveryMethod String
  observedAt      DateTime

  scan   NetworkScan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  device NetworkDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ports  NetworkDevicePort[]

  @@unique([scanId, ipAddress])
  @@index([deviceId, observedAt])
}

model NetworkDevicePort {
  id            String  @id @default(dbgenerated("('network_port_'::text || nextval('\"NetworkDevicePort_id_seq\"'::regclass))"))
  observationId String
  port          Int
  protocol      String
  state         String
  service       String?

  observation NetworkDeviceObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, port, protocol])
}

model NetworkChange {
  id        String   @id @default(dbgenerated("('network_change_'::text || nextval('\"NetworkChange_id_seq\"'::regclass))"))
  networkId String
  scanId    String
  deviceId  String?
  type      String
  key       String
  severity  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  network Network        @relation(fields: [networkId], references: [id], onDelete: Cascade)
  scan    NetworkScan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  device  NetworkDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([networkId, createdAt])
  @@index([scanId])
}
